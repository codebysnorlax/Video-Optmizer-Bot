# Telegram MTProto & Bot Credentials (get API_ID/HASH from https://my.telegram.org)
BOT_TOKEN=your_bot_token_here
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Storage Paths
DOWNLOAD_DIR=storage/downloads
OUTPUT_DIR=storage/outputs
AI_WORKPLACE_DIR=storage/Ai_Workplace
DB_PATH=database/optimizer.db

# OpenRouter AI Configuration (Free Models available at https://openrouter.ai/models?q=free)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# Performance & Concurrency
MAX_CONCURRENT_ENCODING=1
PROGRESS_UPDATE_INTERVAL=2.5

# Encoding Defaults
DEFAULT_AUDIO_BITRATE=128k
MAX_VIDEO_BITRATE=6000k
